# Postgres used by the n8n WhatsApp workflow (the same wa_* tables)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=false

# Any long random string. Signs the login cookie. Changing it logs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# n8n platform API — the Platform API Webhook in the SaaS workflow
N8N_API_URL=https://n8n.example.com/webhook/saas-api
N8N_API_KEY=replace-with-your-platform-api-key
